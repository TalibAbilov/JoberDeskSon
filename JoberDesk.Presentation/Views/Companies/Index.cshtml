 @using JoberDesk.Business.DTOs.Company
@using JoberDesk.Business.DTOs.Industry
@model CompanyPaginationDto





<section class="main-banner" style="background:#242c36 url('@Url.Content("~/assets/img/slider-01.jpg")') no-repeat">
    <div class="container">
        <div class="caption">
            <h2>Karyeranızı qurun</h2>
            <form asp-action="Index" asp-controller="Companies" method="get">
                <fieldset>
                    <div class="col-md-5 col-sm-5 no-pad">
                        <input type="text"  value="@ViewBag.Search" name="search" class="form-control border-right" placeholder="Şirkət adı ilə axtar..." />
                    </div>

                    <div class="col-md-4 col-sm-4 no-pad">
                        <select class="selectpicker" name="industryId">
                            <option value="">Sənaye sahəsi seç</option>
                            @foreach (GetIndustryDto dto in ViewBag.Industries)
                            {
                                <option value="@dto.Id">@dto.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-sm-3 no-pad">
                        <input type="submit" class="btn seub-btn" value="Axtar" />
                    </div>
                </fieldset>
            </form>
        </div>
    </div>
</section>




<section class="site-section" id="next">
    <div class="container">
        <div class="row mb-5 justify-content-center">
            <div class="col-md-7 text-center">
                <h2 class="section-title mb-2" style="text-align:center">Toplam @Model.TotalCompanies Şirkət</h2>
            </div>
        </div>

        <ul class="job-listings mb-5">
            @foreach (var company in Model.Companies)
            {
                <li class="job-listing d-flex align-items-center p-3">
                    <div class="job-listing-logo" style="width:200px">
                        <img style="width:200px" src="~/Upload/Company/@company.Logo" alt="@company.CompanyName Logo" class="img-fluid">
                    </div>
                    <div class="job-listing-about d-flex flex-column justify-content-center ml-3">
                        <h2 class="company-name mb-1"><a asp-action="CompanyDetail" asp-route-id="@company.Id">@company.CompanyName</a></h2>
                        <div class="industry-list">
                            @foreach (var item in company.IndustryCompanies)
                            {
                               
                                    <strong>@item.Industry.Name</strong>
                               
                                if (company.IndustryCompanies.Last()!=item)
                                {
                                    <span>, </span>
                                }
                            }
                        </div>
                    </div>
                    <div class="ml-auto job-count">
                        <span>@company.Jobs.Count Vakansiya</span>
                    </div>
                </li>
            }
        </ul>

        <div class="row pagination-wrap">
            

            <div class="col-md-6 text-center text-md-right">
                <div class="custom-pagination ml-auto">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="?search=@(Context.Request.Query["search"])&industryId=@(Context.Request.Query["industryId"])&page=@(Model.CurrentPage - 1)" class="prev">Əvvəlki</a>
                    }

                    <div class="d-inline-block">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a href="?search=@(Context.Request.Query["search"])&industryId=@(Context.Request.Query["industryId"])&page=@i"
                               class="@(i == Model.CurrentPage ? "active" : "")">@i</a>
                        }
                    </div>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="?search=@(Context.Request.Query["search"])&industryId=@(Context.Request.Query["industryId"])&page=@(Model.CurrentPage + 1)" class="next">Növbəti</a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .job-listing {
        background: #f0f0f0; /* Bozumtul fon */
        border-radius: 10px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        display: flex;
        align-items: center;
        padding: 15px;
        justify-content: space-between; /* Düzgün yerləşdirmək üçün */
        margin-bottom: 15px; /* Company-lər arasında boşluq */
        cursor: pointer; /* Hover effekti üçün əl ikonu */
    }

        .job-listing:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 10px rgba(0, 0, 0, 0.15);
            background: #e0e0e0; /* Hover zamanı fon açıq boz olsun */
        }

    .job-listing-logo img {
        width: 150px;
        height: 100px;
        object-fit: contain;
        border-radius: 5px;
       
        padding: 5px;
    }

    .job-listing-about {
        flex: 1;
        margin-left: 20px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .company-name {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .industry-list {
        font-size: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .industry-link {
        text-decoration: none;
        font-weight: bold;
        color: #e74c3c;
        transition: color 0.3s;
    }

        .industry-link:hover {
            color: #c0392b;
        }

    .job-count {
        font-size: 14px;
        font-weight: bold;
        background: #dcdcdc;
        padding: 5px 15px;
        border-radius: 20px;
        color: #333;
        align-self: center;}
    .custom-pagination
    {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .custom-pagination a {
        display: inline-block;
        padding: 8px 14px;
        text-decoration: none;
        font-weight: bold;
        color: #333;
        background: #f1f1f1;
        border-radius: 5px;
        transition: background 0.3s, color 0.3s;
    }

        .custom-pagination a:hover {
            background: #007bff;
            color: white;
        }

        .custom-pagination a.active {
            background: #007bff;
            color: white;
            pointer-events: none;
        }

    .custom-pagination .prev,
    .custom-pagination .next {
        font-weight: bold;
        background: #ddd;
    }

        .custom-pagination .prev:hover,
        .custom-pagination .next:hover {
            background: #0056b3;
            color: white;
        }
    }
</style>



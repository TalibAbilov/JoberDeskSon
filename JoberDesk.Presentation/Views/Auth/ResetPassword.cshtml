@using JoberDesk.Business.DTOs.User
@model ResetPasswordDto

<!-- Login Section Start -->
<section class="login-wrapper">
    <div class="container">
        <div class="col-md-6 col-sm-8 col-md-offset-3 col-sm-offset-2">
            <form method="post" class="card shadow p-4">
                <div class="text-center mb-4">
                    <img class="img-responsive" alt="logo" src="~/Assets/img/logo.png" style="max-width: 150px;">
                </div>


                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="NewPassword" class="fw-bold">Şifrə</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Şifrə daxil edin...">
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="ConfirmPassword" class="fw-bold">Təsdiq şifrəsi</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Təsdiq şifrəsi daxil edin...">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg btn-block mt-3" style="background-color: #da0833; border-color: #da0833;">
                    Şifrəni dəyiş
                </button>

            </form>

        </div>
    </div>
</section>

<!-- Login Section End -->

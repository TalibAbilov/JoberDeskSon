@using JoberDesk.Business.DTOs.User
@using JoberDesk.Core.Enums
@model LoginDto
<!-- login section start -->
<section class="login-wrapper">
	<div class="container">
		<div class="col-md-6 col-sm-8 col-md-offset-3 col-sm-offset-2">
            <form method="post" class="card p-4 shadow-lg" style="max-width: 400px; margin: auto; border-radius: 10px;">
                <div class="text-center">
                    <img class="img-fluid mb-3" alt="logo" src="~/Assets/img/logo.png" style="max-width: 150px;">
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="font-weight-bold">E-poçt adresi</label>
                    <input asp-for="Email" type="email" class="form-control input-lg" placeholder="E-poçt adresi daxil edin...">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="font-weight-bold">Şifrə</label>
                    <input asp-for="Password" type="password" class="form-control input-lg" placeholder="Şifrə daxil edin...">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check" style="display: flex; align-items: center;">
                    <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe" style="margin-top: 0;">
                    <label asp-for="RememberMe" class="form-check-label ms-2" for="rememberMe">Məni xatırla</label>
                </div>

                <div class="text-right">
                    <a asp-action="ForgetPassword" asp-controller="Auth" class="text-primary font-weight-bold">Şifrəni unutdum</a>
                </div>

                <div class="text-center mt-3">
                    <p>Hesabın yoxdur? <a asp-action="Register" asp-controller="Auth" class="text-primary font-weight-bold">Hesab yarat</a></p>
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>

                <button type="submit" class="btn btn-primary btn-lg btn-block mt-3" style="background-color: #da0833; border-color: #da0833;">
                    Hesaba giriş
                </button>
            </form>
		</div>
	</div>
</section>
<!-- login section End -->	
@using JoberDesk.Business.DTOs.Home
@using JoberDesk.Business.DTOs.Job
@using JoberDesk.Core.Enums
@model HomeDto





<section class="counter" style="margin-top:50px;margin-bottom:50px">
	<div class="container">
		<div class="col-md-6 col-sm-3">
			<div class="counter-text">
				<span aria-hidden="true" class="icon-briefcase"></span>
				<h3>@Model.JobCount</h3>
				<p>Vakansiya</p>
			</div>
		</div>

		<div class="col-md-6 col-sm-3">
			<div class="counter-text">
				<span class="box1"><span aria-hidden="true" class="icon-expand"></span></span>
				<h3>@Model.CompanyCount</h3>
				<p>Şirkət</p>
			</div>
		</div>


	</div>
</section>

		<!-- Main jumbotron for a primary marketing message or call to action -->



<section class="main-banner" style="background:#242c36 url('@Url.Content("~/assets/img/slider-01.jpg")') no-repeat">
	<div class="container">
		<div class="caption">
			<h2>Karyeranızı qurun</h2>
			<form asp-action="Index" asp-controller="Home" method="get">
				<fieldset>
					<div class="container">
						<div class="row mb-3">
							<div class="col-md-6">
								<input type="text" value="@ViewBag.Search" name="search" class="form-control" placeholder="Vakansiya adı ilə axtar..." />
							</div>
							<div class="col-md-4">
								<select class="form-control selectpicker" name="categoryId">
									<option value="">Kateqoriya seç</option>
									@foreach (var category in Model.Categories)
									{
										<option value="@category.Id">@category.Name</option>
									}
								</select>
							</div>
							<div class="col-md-3">
								<select class="form-control selectpicker" name="jobType">
									<option value="">İş tipini seç</option>
									@foreach (var type in Enum.GetValues(typeof(EmploymentType)))
									{
										<option value="@type">@type</option>
									}
								</select>
							</div>

							<div class="col-md-3">
								<select class="form-control selectpicker" name="educationLevel">
									<option value="">Təhsil səviyyəsini seç</option>
									@foreach (var level in Enum.GetValues(typeof(EducationLevel)))
									{
										<option value="@level">@level</option>
									}
								</select>
							</div>
						</div>

						<div class="row mb-3 p-3" style="border-radius: 10px;">
							<div class="col-md-3">
								<select class="form-control selectpicker" name="experienceYear">
									<option value="">Təcrübə ilini seç</option>
									@foreach (var year in Enum.GetValues(typeof(ExperienceLevel)))
									{
										<option value="@year">@year</option>
									}
								</select>
							</div>

							<div class="col-md-3">
								<select class="form-control selectpicker" name="sortBy">
									<option value="">Tarixə görə sıralama</option>
									<option value="newest">Ən yenilər</option>
									<option value="oldest">Ən köhnələr</option>
								</select>
							</div>

							<div class="col-md-4">
								<label for="salaryRange">Maaş aralığı:</label>
								<div class="d-flex align-items-center">
									<input type="range" id="salaryMin" name="minSalary" min="0" max="10000" value="0" step="100" oninput="updateSalaryRange()" class="form-control-range">
									<span id="minSalaryValue" class="mx-2">0</span> ₼ –
									<input type="range" id="salaryMax" name="maxSalary" min="0" max="10000" value="10000" step="100" oninput="updateSalaryRange()" class="form-control-range">
									<span id="maxSalaryValue" class="mx-2">10,000</span> ₼
								</div>
							</div>

							<div class="col-md-6 d-flex justify-content-center mt-3">
								<input type="submit" class="btn btn-primary btn-lg px-5 py-3" value="Axtar" />
							</div>
						</div>


					</div>
				</fieldset>

			</form>
		</div>
	</div>
</section>



<section class="jobs">
	<div class="container">
		<ul class="job-listings mb-5">
			

			@if (Model.JobPaginationDto.Jobs.Count==0)
			{
				<div class="alert alert-warning">
					<span>Axtarışınıza uyğun nəticə tapılmadı</span>
				</div>
			}
			@foreach (var vacancy in Model.JobPaginationDto.Jobs)
			{
				<li class="job-listing d-flex align-items-center p-3 position-relative @(vacancy.IsPremium ? "premium-job" : "")">
					<div class="job-listing-logo" style="width:200px">
						<img style="width:200px" src="~/Upload/Company/@vacancy.Company.Logo" alt="Logo" class="img-fluid">
					</div>
					<div class="job-listing-about d-flex flex-column justify-content-center ml-3">
						<h2 class="company-name mb-1">
							<a asp-action="VacancyDetail" asp-controller="Vacancies" asp-route-id="@vacancy.Id">@vacancy.Name</a>
						</h2>
						<p>
							<span class="company-naame"><i style="margin-right:5px" class="fa fa-briefcase"></i><a asp-action="CompanyDetail" asp-controller="Companies" asp-route-id="@vacancy.CompanyId">@vacancy.Company.CompanyName</a></span>
							<span class="company-location"><i style="margin-left:5px" class="fa fa-map-marker"></i> @vacancy.Location</span>
							@if (vacancy.Salary != 0)
							{
								<span class="package"><i style="margin-left:5px;margin-right:5px;color:dimgray" class="fa fa-money"></i>@vacancy.Salary ₼</span>
							}
						</p>
						<p class="job-views">
							<i class="fa fa-eye"></i> @vacancy.ViewCount baxış
						</p>
						<p class="job-date">
							<i class="fa fa-calendar"></i> @vacancy.CreatedAt.ToString("dd.MM.yyyy")
						</p>
					</div>
					<div class="job-meta d-flex flex-column align-items-center">
						@if (vacancy.IsPremium)
						{
							<span class="premium-badge">Premium</span>
						}
						<span class="job-type">@vacancy.EmploymentType.ToString()</span>
					</div>
				</li>
			}

		</ul>
		<div class="row">
			<a class="btn brows-btn" asp-action="Index">Bütün işlər</a>
		</div>

		<div class="row pagination-wrap">
			<div class="col-md-6 text-center text-md-right">
				<div class="custom-pagination ml-auto">
					@if (Model.JobPaginationDto.TotalPages > 1)
					{
						<div class="row pagination-wrap justify-content-center mt-4">
							<div class="col-12 text-center">
								<nav class="custom-pagination">
									@if (Model.JobPaginationDto.CurrentPage > 1)
									{
										<a href="?search=@(Context.Request.Query["search"])&jobType=@(Context.Request.Query["jobType"])&educationLevel=@(Context.Request.Query["educationLevel"])&experienceYear=@(Context.Request.Query["experienceYear"])&sortBy=@(Context.Request.Query["sortBy"])&minSalary=@(Context.Request.Query["minSalary"])&maxSalary=@(Context.Request.Query["maxSalary"])&page=@(Model.JobPaginationDto.CurrentPage - 1)" class="prev">
											Əvvəlki
										</a>
									}

									@for (int i = 1; i <= Model.JobPaginationDto.TotalPages; i++)
									{
										<a href="?search=@(Context.Request.Query["search"])&jobType=@(Context.Request.Query["jobType"])&educationLevel=@(Context.Request.Query["educationLevel"])&experienceYear=@(Context.Request.Query["experienceYear"])&sortBy=@(Context.Request.Query["sortBy"])&minSalary=@(Context.Request.Query["minSalary"])&maxSalary=@(Context.Request.Query["maxSalary"])&page=@i"
										   class="@(i == Model.JobPaginationDto.CurrentPage ? "active" : "")">
											@i
										</a>
									}

									@if (Model.JobPaginationDto.CurrentPage < Model.JobPaginationDto.TotalPages)
									{
										<a href="?search=@(Context.Request.Query["search"])&jobType=@(Context.Request.Query["jobType"])&educationLevel=@(Context.Request.Query["educationLevel"])&experienceYear=@(Context.Request.Query["experienceYear"])&sortBy=@(Context.Request.Query["sortBy"])&minSalary=@(Context.Request.Query["minSalary"])&maxSalary=@(Context.Request.Query["maxSalary"])&page=@(Model.JobPaginationDto.CurrentPage + 1)" class="next">
											Növbəti
										</a>
									}
								</nav>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</section>

<section class="features">
	<div class="container">

		<div class="col-md-6 col-sm-4">
			<div class="features-content">
				<span class="box1"><span aria-hidden="true" class="icon-search"></span></span>
				<h3>Vakansiyalar axtarın</h3>
				<p>Bacarıqlarınıza uyğun axtarışlar edib, sizə uyğun vakansiyalara müraciət edin.</p>
			</div>
		</div>
		<div class="col-md-6 col-sm-4">
			<div class="features-content">
				<span class="box1"><span aria-hidden="true" class="icon-dial"></span></span>
				<h3>Hesab yaradın</h3>
				<p>Şirkət hesabınızı yaradaraq vakansiyalara müraciət edə, şirkət hesabınızı yaradaraq vakansiyalar paylaşa bilərsiniz.</p>
			</div>
		</div>
	</div>
</section>




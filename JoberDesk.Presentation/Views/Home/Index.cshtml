<script>
	function updateSalaryRange() {
		var minSalary = document.getElementById("salaryMin").value;
		var maxSalary = document.getElementById("salaryMax").value;

		if (parseInt(minSalary) > parseInt(maxSalary)) {
			document.getElementById("salaryMin").value = maxSalary;
			document.getElementById("minSalaryValue").innerText = maxSalary;
		} else {
			document.getElementById("minSalaryValue").innerText = minSalary;
		}

		document.getElementById("maxSalaryValue").innerText = maxSalary;
	}
</script>


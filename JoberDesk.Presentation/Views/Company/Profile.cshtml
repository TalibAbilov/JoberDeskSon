@using JoberDesk.Business.DTOs.Company
@model GetCompanyDto

@{
	int step = 0;
}

<section class="inner-banner" style="background: linear-gradient(rgba(36, 44, 54, 0.8), rgba(36, 44, 54, 0.8)), url('https://via.placeholder.com/1920x600') no-repeat center center; background-size: cover; background-attachment: fixed;">
	<div class="container text-center">
		<div class="caption">
			<h1 class="text-white">@Model.CompanyName</h1>
			<p class="text-white">Şirkətin vakansiya sayı:<span class="badge bg-success"> @Model.Jobs.Count</span></p>
			<a class="btn btn-primary" asp-action="MyVacancies" asp-controller="Job">Vakansiyalarım</a>
		</div>
	</div>
</section>



<section class="profile-detail">
	<div class="container">
		<div class="col-md-12">
			<div class="row">
				<div class="basic-information">
					<div class="col-md-9 col-sm-9">
						
						<div class="profile-content">
							<h3>Şirkət məlumatları</h3>
							<a style="color:blue" class="btn btn-secondary" asp-action="Update" asp-route-id="@Model.Id">Düzəliş et</a>
							<hr />
							<ul class="information">

								<li>
									<span>Təsdiqlənib?:</span>
									@if (Model.IsConfirmedByAdmin)
									{
										<span class="text-success">Bəli</span>
									}
									else
									{
										<span class="text-danger">Xeyr</span>
									}
								</li>

								<li><span>E-poçt adresi:</span>@Model.AppUser?.Email</li>

								<li><span>Şirkət adı:</span>@Model.CompanyName</li>

								<li>
									<span>Şirkət Loqosu:</span><img src="~/Upload/Company/@Model.Logo" alt="" style="width:200px" class="img-responsive">
								</li>
								<li>
									<span>Sənaye tipləri:</span>
									@foreach (var item in Model.IndustryCompanies)
									{
										step += 1;
										if (Model.IndustryCompanies.Count > step)
										{
											<a asp-action="Index" asp-controller="Category" style="color:red">@item.Industry.Name,</a>

										}
										else
										{
											<a style="color:red">@item.Industry.Name</a>

										}

									}
								</li>
								<li><span>Ünvan:</span>@Model.Address</li>
									@if (!string.IsNullOrEmpty(Model.Website))
									{
										<li>

										<span>Website:</span>
										<a href="@Model.Website" target="_blank" class="website-link">
											@Model.Website
										</a>
										</li>
									}
									
								


							</ul>
						</div>
					</div>
					<ul class="social">
				
						
					</ul>
					<div class="panel panel-default">
						<div class="panel-heading">


							<i class="fa fa-user fa-fw"></i>@Model.CompanyName Haqqında
						</div>
						<!-- /.panel-heading -->
						<div >

							<p>@(Html.Raw(Model.About))</p>
						</div>
					</div>

					


				</div>
			</div>
		</div>
	</div>
</section>
	<script>
		var quillDescription = new Quill('#quill-editor-description', {
			theme: 'snow',
			placeholder: 'Məlumat...',
			modules: {
				toolbar: [
					[{ 'header': '1' }, { 'header': '2' }, { 'font': [] }],
					[{ 'list': 'ordered' }, { 'list': 'bullet' }],
					['bold', 'italic', 'underline'],
					['link'],
					[{ 'align': [] }],
					['clean']
				]
			}
		});

		// Serverdən gələn dəyəri (modeldən) götür və Quill-ə əlavə et
		var aboutValue = document.getElementById("about-input").value;
		if (aboutValue.trim() !== "") {
			quillDescription.root.innerHTML = aboutValue; // Əgər məlumat varsa, Quill-ə əlavə et
		}

		// Quill məzmunu dəyişdikdə avtomatik input-a yazır
		quillDescription.on('text-change', function () {
			document.getElementById('about-input').value = quillDescription.root.innerHTML;
		});

		// Form submit olmamışdan əvvəl input-a Quill məzmununu yazırıq
		document.querySelector("form").addEventListener("submit", function () {
			document.getElementById("about-input").value = quillDescription.root.innerHTML;
		});
	</script>


	<script>
    var quillRequirements = new Quill('#quill-editor-requirements', {
        theme: 'snow',
        placeholder: 'Vakansiya tələbləri...',
        modules: {
            toolbar: [
                [{ 'header': '1' }, { 'header': '2' }, { 'font': [] }],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['bold', 'italic', 'underline'],
                ['link'],
                [{ 'align': [] }],
                ['clean']
            ]
        }
    });

    // Serverdən gələn dəyəri (modeldən) götür və Quill-ə əlavə et
    var requirementsValue = document.getElementById("requirements-input").value;
    if (requirementsValue.trim() !== "") {
        quillRequirements.root.innerHTML = requirementsValue; // Əgər məlumat varsa, Quill-ə əlavə et
    }

    // Quill məzmunu dəyişdikdə avtomatik input-a yazır
    quillRequirements.on('text-change', function () {
        document.getElementById('requirements-input').value = quillRequirements.root.innerHTML;
    });

    // Form submit olmamışdan əvvəl input-a Quill məzmununu yazırıq
    document.querySelector("form").addEventListener("submit", function () {
        document.getElementById("requirements-input").value = quillRequirements.root.innerHTML;
    });
</script>

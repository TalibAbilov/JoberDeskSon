							<p>@(Html.Raw(Model.Description))</p>
						</div>
					</div>
					<div class="panel panel-default">
						<div class="panel-heading">


							<i class="fa fa-list fa-fw"></i> İşin tələbləri
						</div>
						<!-- /.panel-heading -->
						<div class="panel-body">

							<p>@(Html.Raw(Model.Requirements))</p>
						</div>
					</div>



@using JoberDesk.Business.DTOs.Job
@model GetJobDto



<section class="inner-banner" style="background: linear-gradient(rgba(36, 44, 54, 0.8), rgba(36, 44, 54, 0.8)), url('https://via.placeholder.com/1920x600') no-repeat center center; background-size: cover;">
	<div class="container">
		<div class="caption">
			<h2>Get your jobs</h2>
			<p>Get your Popular jobs <span>202 New job</span></p>
		</div>
	</div>
</section>



<section class="profile-detail">
	<div class="container">
		<div class="col-md-12">
			<div class="row">
				<div class="basic-information">
					<div class="col-md-9 col-sm-9">

						<div class="profile-content">
							<h3>Vakansiya məlumatları</h3>
							<hr />
							<ul class="information">
								<li><span>Vakansiya adı:</span>@Model.Name</li>
								<li><span>Vakansiya kateqoriyası:</span>@Model.Category.Name</li>
								<li><span>Paylaşıldığı tarix:</span>@Model.CreatedAt.ToString("dd/MM/yyyy")</li>
								<li><span>Bitmə tarixi:</span>@Model.EndTime.ToString("dd/MM/yyyy")</li>
								<li><span>Tələb olunun minumum iş təcrübəsi:</span>@Model.ExperienceLevel.ToString()</li>
								<li><span>Tələb olunun minumum təhsil:</span>@Model.EducationLevel.ToString()</li>
								<li><span>İş növü:</span>@Model.EmploymentType.ToString()</li>
							</ul>
						</div>
					</div>
					<ul class="social">
					</ul>
					<div class="panel panel-default">
						<div class="panel-heading">


							<i class="fa fa-info-circle fa-fw"></i> İş haqqında
						</div>
						<!-- /.panel-heading -->

@using JoberDesk.Business.DTOs.Job
@model GetJobDto

<section class="vacancy-detail">
    <div class="container">
        <div class="row">
            <!-- Left Column -->
            <div class="col-md-8">
                @if (Model.IsPremium)
                {
                    <div class="premium-badge" style="margin-bottom:10px">
                        <span class="badge badge-warning">Premium Vakansiya</span>
                    </div>
                }
                <!-- Vacancy Header -->
                <div class="vacancy-header">
                    <h2>@Model.Name</h2>

                    <!-- Company Information -->
                    
                        <p><strong style="color:#555">Kateqoriya:</strong> @Model.Category.Name</p>
                    
                    <p class="company-name">
                        <i class="fa fa-briefcase" style="color:#555"></i>
                        <strong style="color:#555">Şirkət:</strong>
                        <a asp-action="CompanyDetail" asp-route-id="@Model.Company.Id">@Model.Company.CompanyName</a>
                    </p>

                    <!-- Location -->
                    <p class="job-location">
                        <i class="fa fa-map-marker" style="color:#555"></i><strong style="color:#555">Ünvan:</strong>
                        @Model.Location
                    </p>

                    <!-- Salary Information -->
                    <p class="job-salary">
                        @if (Model.Salary > 0)
                        {
                            <span><i class="fa fa-money"></i><strong>Maaş:</strong> @Model.Salary ₼</span>
                        }
@*                         else
                        {
                            <span>Razılaşma yolu ilə</span>
                        } *@
                    </p>

                    <p class="employment-type">
                        <strong>İş tipi:</strong> @Model.EmploymentType
                    </p>

                    <!-- Experience Level -->
                    <p class="experience-level">
                        <strong>Təcrübə səviyyəsi:</strong> @Model.ExperienceLevel
                    </p>

                    <!-- Education Level -->
                    <p class="education-level">
                        <strong>Təhsil səviyyəsi:</strong> @Model.EducationLevel
                    </p>
                </div>

                <!-- Vacancy Description -->
                <div class="vacancy-description">
                    <h4>Vakansiya Təsviri:</h4>
                    <p>@Html.Raw(Model.Description)</p>
                </div>

                <!-- Vacancy Requirements -->
                <div class="vacancy-requirements">
                    <h4>Tələblər:</h4>
                    <p>@Html.Raw(Model.Requirements)</p>
                </div>

                <!-- Job End Time -->
                <div class="vacancy-end-time">
                    <p><strong>Son müraciət vaxtı:</strong> @Model.EndTime.ToString("dd.MM.yyyy")</p>
                </div>

                

                
            </div>
        </div>
    </div>
</section>
<style>/* General Style */
.vacancy-detail {
    background-color: #f7f7f7;
    padding: 60px 20px;
}

/* Container */
.vacancy-detail .container {
    max-width: 1150px;
    margin: 0 auto;
    padding: 0 15px;
}

/* Vacancy Header */
.vacancy-header {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 30px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    margin-bottom: 40px;
}

.vacancy-header h2 {
    font-size: 36px;
    font-weight: 700;
    color: #333;
    margin-bottom: 20px;
}

.vacancy-header p {
    font-size: 16px;
    color: #777;
    margin: 8px 0;
}

.vacancy-header .company-name a {
    color: #007bff;
    text-decoration: none;
}

.vacancy-header .company-name a:hover {
    text-decoration: underline;
}

.vacancy-header .job-location i,
.vacancy-header .job-salary i {
    color: #007bff;
}

.vacancy-header .job-salary span {
    font-weight: 600;
    color: #28a745;
}

/* Category, Employment, Experience */
.vacancy-header .job-category,
.vacancy-header .employment-type,
.vacancy-header .experience-level,
.vacancy-header .education-level {
    font-size: 16px;
    color: #555;
    margin: 10px 0;
}

/* Description Section */
.vacancy-description,
.vacancy-requirements {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    margin-bottom: 30px;
}

.vacancy-description h4,
.vacancy-requirements h4 {
    font-size: 24px;
    font-weight: 600;
    color: #333;
    margin-bottom: 15px;
}

.vacancy-description p,
.vacancy-requirements p {
    font-size: 16px;
    color: #555;
    line-height: 1.6;
}

/* Job End Time */
.vacancy-end-time {
    font-size: 16px;
    color: #777;
    margin-top: 20px;
}

.vacancy-end-time strong {
    color: #333;
}

/* Premium Badge */
.premium-badge {
    margin-top: 20px;
}

.premium-badge .badge {
    font-size: 14px;
    padding: 8px 12px;
    background-color: #f8c15c;
    color: #333;
    border-radius: 3px;
    font-weight: 600;
}

/* Responsive Design */
media (max-width: 768px) {
    .vacancy-detail .container {
        padding: 0 10px;
    }

    .vacancy-header h2 {
        font-size: 28px;
    }

    .vacancy-header p {
        font-size: 14px;
    }

    .vacancy-description h4,
    .vacancy-requirements h4 {
        font-size: 20px;
    }

    .vacancy-description p,
    .vacancy-requirements p {
        font-size: 14px;
    }

    .vacancy-header .job-category,
    .vacancy-header .employment-type,
    .vacancy-header .experience-level,
    .vacancy-header .education-level {
        font-size: 14px;
    }

    .vacancy-end-time {
        font-size: 14px;
    }

    .premium-badge .badge {
        font-size: 12px;
        padding: 6px 10px;
    }
}</style>
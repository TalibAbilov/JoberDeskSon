@using JoberDesk.Business.DTOs.Company
@model SendRejectionMessageDto


<div class="container mt-4">
    <h3>Təsdiq edilməmə səbəbi</h3>
    <form method="post" action="@Url.Action("SendRejectionMessage", "CompanyManagement")">
        <input type="hidden" name="CompanyId" value="@Model.CompanyId" />

        <div class="form-group">
            <label asp-for="LastRejectionReason">Səbəb:</label>
            <textarea asp-for="LastRejectionReason" class="form-control"></textarea>
            <span asp-validation-for="LastRejectionReason"></span>
        </div>
        <div class="form-group mt-3">
            <button type="submit" class="btn btn-danger">Göndər</button>
            <a href="@Url.Action("Index", "CompanyManagement")" class="btn btn-secondary">İmtina et</a>
        </div>
    </form>
</div>

@model List<GetCategoryDto>
@{
    int count = 0;
}
<div class="container">
    <a class="btn btn-primary" asp-action="Create">Yarat</a>
   
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Id</th>
                <th scope="col">Ikon</th>
                <th scope="col">Ad</th>
                <th scope="col">Vakansiya sayı</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                count++;
                <tr>
                    <th scope="row">@count</th>
                    <td>@item.Id</td>
                    <td>@Html.Raw(item.Icon)</td>
                    <td>@item.Name</td>
                    <td>@item.Jobs.Count</td>
                    <td>
                        <a class="btn btn-secondary" asp-action="Update" asp-route-id="@item.Id">Redaktə</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@using JoberDesk.Business.DTOs.Industry
@model UpdateIndustryDto
<div class="container">
    <p>
        İkon seçmək üçün <a href="https://fontawesome.com/search?ic=free" target="_blank">buraya</a> keçid edin və seçdiyiniz ikonu kopyalayıb formaya əlavə edin.
        (məsələn <code>&lt;i class="fa-solid fa-bolt"&gt;&lt;/i&gt;</code>)
    </p>
    <form method="post">
        <div class="form-group">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" class="form-control" placeholder="Enter name">
            <span asp-validation-for="Name" style="color:red"></span>
        </div>
        <div class="form-group">
            <label asp-for="Icon">Icon</label>
            <input asp-for="Icon" class="form-control" placeholder="Enter icon">
            <span asp-validation-for="Icon" style="color:red"></span>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>
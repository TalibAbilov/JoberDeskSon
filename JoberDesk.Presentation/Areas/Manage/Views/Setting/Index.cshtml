@using JoberDesk.Business.Services.Interfaces
@inject ILayoutService layoutservice

@model Dictionary<string, string>
@{
    int count = 0;
}

<a class="btn btn-primary ml-5 mb-3" asp-action="Create">Yarat</a>
<table class="table table-striped table-white">
    <thead>
        <tr>
            <th scope="col">#</th>
           
            <th scope="col">Açar</th>
            <th scope="col">Dəyər</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            count++;
            <tr>
                <th scope="row">@count</th>
                <td>@item.Key</td>
                <td>@item.Value</td>
                <td>
                    <a class="btn btn-secondary" asp-action="Update" asp-route-key=@item.Key>Redaktə et</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-key=@item.Key>Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>